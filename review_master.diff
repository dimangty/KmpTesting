-def to_pascal(value: str) -> str:
-    parts = re.split(r"[^A-Za-z0-9]+", value)
-    cleaned = [p for p in parts if p]
-    if not cleaned:
-        raise ValueError("screen name must contain letters or digits")
-    return "".join(word[:1].upper() + word[1:] for word in cleaned)
